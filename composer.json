{
    "name": "sailantis/azera-aop",
    "description": "AOP companion for the Azera framework: additional advice attributes and interceptors (Audit, Throttle, Authorize, Validate, CircuitBreaker, Idempotent, Bulkhead, Trace).",
    "type": "library",
    "repositories": [
        { "type": "path", "url": "../azera-framework" },
        { "type": "path", "url": "../azera-auth" },
        { "type": "path", "url": "../azera-cache" },
        { "type": "path", "url": "../clarity-engine" }
    ],
    "require": {
        "php": ">=8.1",
        "sailantis/azera-framework": "dev-main",
        "psr/log": "3.0",
        "psr/simple-cache": "3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "sailantis/azera-auth": "For the Authorize interceptor (Gate/Authorizable integration).",
        "sailantis/azera-cache": "For the Throttle and Idempotent interceptors (PSR-16 storage)."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Azera\\Aop\\Advice\\": "src/Advice/",
            "Azera\\Aop\\Interceptor\\": "src/Interceptor/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Azera\\Aop\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}